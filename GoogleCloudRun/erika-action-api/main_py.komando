cd ~/erika-action-api

cat << 'EOF' > main.py
import asyncio
import random
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

app = FastAPI(title="Erika Rock Action Cloud Run API")

# ★ 修正：本番ドメイン、すべての *.pages.dev プレビューURL、ローカル環境を正規表現で一括許可！
app.add_middleware(
    CORSMiddleware,
    allow_origin_regex=r"https://(.*\.)?(erikakataru\.com|erika-official\.pages\.dev)|http://(localhost|127\.0\.0\.1)(:\d+)?",
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# 敵のスピードもエリカの速度（2/3倍）に合わせてマイルドに調整
ENEMY_CATALOG = [
    {"type": "soot",       "name": "煤玉モンスター",   "hp": 10, "speed": 1.4, "score": 100, "stompable": True},
    {"type": "lime",       "name": "ライム豆っこ",     "hp": 10, "speed": 2.0, "score": 150, "stompable": True},
    {"type": "jelly",      "name": "桃色ゼリー",       "hp": 15, "speed": 1.3, "score": 200, "stompable": True},
    {"type": "note_ghost", "name": "音符のおばけ",     "hp": 15, "speed": 1.6, "score": 250, "stompable": True},
    {"type": "turtle",     "name": "ずんぐりカメ",     "hp": 35, "speed": 0.8, "score": 300, "stompable": True,  "armored": True},
    {"type": "mole",       "name": "鉱夫モグラ",       "hp": 20, "speed": 0.0, "score": 350, "stompable": False, "helmet": True},
    {"type": "hedgehog",   "name": "赤いハリネズミ",   "hp": 25, "speed": 4.2, "score": 400, "stompable": False, "spiky": True},
]

QUOTES = [
    {"quote": "手探りでもただ前に進むしかない。いずれなんとかなるだろってな。", "source": "『シャーマンキング』麻倉葉"},
    {"quote": "お前が信じる、お前を信じろ！", "source": "『天元突破グレンラガン』カミナ"},
]

async def generate_enemy_waves(stage: int):
    await asyncio.sleep(0.02)
    waves = []
    current_delay = 1000
    for i in range(6 + stage * 2):
        enemy = random.choice(ENEMY_CATALOG)
        waves.append({
            "id": f"enemy_{i}",
            "spawn_delay_ms": current_delay,
            **enemy
        })
        current_delay += random.randint(2200, 3800)
    return waves

async def generate_boss_data(stage: int):
    await asyncio.sleep(0.02)
    return {
        "boss_name": f"SHADOW ERIKA // STAGE {stage}",
        "hp": 120 + (stage * 30),
        "cutin_quote": random.choice(QUOTES)
    }

@app.get("/api/health")
async def health():
    return {"status": "ok", "message": "Erika Action API is awake!"}

@app.get("/api/stage-start")
async def stage_start(stage: int = 1):
    waves, boss = await asyncio.gather(
        generate_enemy_waves(stage),
        generate_boss_data(stage)
    )
    return {
        "stage": stage,
        "enemy_waves": waves,
        "boss": boss
    }
EOF

# 再デプロイ実行（URLは変わらずそのまま更新されます）
gcloud run deploy erika-action-api \
  --source . \
  --region asia-northeast1 \
  --allow-unauthenticated \
  --min-instances 0 \
  --max-instances 1 \
  --memory 256Mi \
  --cpu 1